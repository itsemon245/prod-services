# Pinned image versions. Review release notes before changing them on an
# existing production VM. For immutable deploys you can append a digest,
# for example redis:8.8.4-alpine@sha256:<digest>.
REDIS_IMAGE=redis:8.8.4-alpine

# Roles to run on this host (comma separated): cache, session, queue, ws.
# Passwords, ports, data dirs and memory budget are only needed for these.
REDIS_ROLES=cache,session,queue,ws

# Compose project and network. The network name is fixed so app containers on
# the same host can join it with `external: true` and reach redis-<role>:6379.
REDIS_COMPOSE_PROJECT_NAME=redis
REDIS_NETWORK_NAME=redis_default

# Host address the Redis ports are published on. Docker-published ports
# bypass UFW, so never use 0.0.0.0 here. For clients on other hosts either:
#   - set this to a private-network IP of this host (preferred), or
#   - keep 127.0.0.1 and enable the allowlisted gateway below.
REDIS_BIND_ADDRESS=127.0.0.1

REDIS_CACHE_CONTAINER_NAME=redis-cache
REDIS_SESSION_CONTAINER_NAME=redis-session
REDIS_QUEUE_CONTAINER_NAME=redis-queue
REDIS_WS_CONTAINER_NAME=redis-ws

REDIS_CACHE_HOST_PORT=6379
REDIS_SESSION_HOST_PORT=6380
REDIS_QUEUE_HOST_PORT=6381
REDIS_WS_HOST_PORT=6382

# Data dirs live outside the checkout. Create them once as root:
#   sudo install -d -m 0700 -o 999 -g 999 /srv/prod-services/redis/{cache,session,queue,ws}
REDIS_CACHE_DATA_DIR=/srv/prod-services/redis/cache
REDIS_SESSION_DATA_DIR=/srv/prod-services/redis/session
REDIS_QUEUE_DATA_DIR=/srv/prod-services/redis/queue
REDIS_WS_DATA_DIR=/srv/prod-services/redis/ws

# Persistence per role: none, rdb (periodic snapshots) or aof (AOF + RDB).
REDIS_CACHE_PERSISTENCE=none
REDIS_SESSION_PERSISTENCE=rdb
REDIS_QUEUE_PERSISTENCE=aof
REDIS_WS_PERSISTENCE=none

# Eviction policy overrides (defaults shown). Keep the queue on noeviction.
# REDIS_CACHE_MAXMEMORY_POLICY=allkeys-lru
# REDIS_SESSION_MAXMEMORY_POLICY=volatile-ttl
# REDIS_QUEUE_MAXMEMORY_POLICY=noeviction
# REDIS_WS_MAXMEMORY_POLICY=allkeys-lru

REDIS_PIDS_LIMIT=4096
REDIS_STOP_GRACE_PERIOD=30s
REDIS_LOG_MAX_SIZE=100m
REDIS_LOG_MAX_FILE=5

# Generator defaults. Leave commented to tune from host resources. The budget
# is split across enabled roles only (weights cache 30, session 13, queue 52, ws 5).
# REDIS_MEMORY_MB=16384
# REDIS_CPU_CORES=8
# REDIS_HOST_MEMORY_RESERVE_PERCENT=10
# REDIS_MEMORY_BUDGET_PERCENT=70
# REDIS_CACHE_MAXMEMORY_MB=700
# REDIS_SESSION_MAXMEMORY_MB=300
# REDIS_QUEUE_MAXMEMORY_MB=1200
# REDIS_WS_MAXMEMORY_MB=128

# Application passwords (ACL user "default", so clients that send only a
# password keep working). Stored in users.acl as SHA-256 hashes.
# Empty values for enabled roles are generated by make ensure-redis-env.
REDIS_CACHE_PASSWORD=
REDIS_SESSION_PASSWORD=
REDIS_QUEUE_PASSWORD=
REDIS_WS_PASSWORD=

# Operator user "ops" (backups, ACL LOAD, status, migrations). Never give it to apps.
REDIS_ADMIN_PASSWORD=

# Zero-downtime rotation: set REDIS_<ROLE>_PASSWORD_NEXT (or
# REDIS_ADMIN_PASSWORD_NEXT), make reload-redis-acl, move clients, then
# promote it to REDIS_<ROLE>_PASSWORD, clear _NEXT, make reload-redis-acl.
# REDIS_QUEUE_PASSWORD_NEXT=

# ACL rules for the application user. -@admin blocks CONFIG, DEBUG, SHUTDOWN,
# REPLICAOF, MONITOR, ACL SETUSER and similar; normal app commands stay allowed.
# REDIS_APP_ACL_RULES=~* &* +@all -@admin

# Optional HAProxy TCP gateway for clients on other hosts.
REDIS_GATEWAY=off
REDIS_GATEWAY_IMAGE=haproxy:3.2.26-alpine
REDIS_GATEWAY_CONTAINER_NAME=redis-gateway
REDIS_GATEWAY_BIND_ADDRESS=0.0.0.0
# One IP or CIDR per line; anything else is rejected at TCP accept.
REDIS_GATEWAY_ALLOWLIST_FILE=./gateway.allowlist
REDIS_GATEWAY_CACHE_PORT=7379
REDIS_GATEWAY_SESSION_PORT=7380
REDIS_GATEWAY_QUEUE_PORT=7381
REDIS_GATEWAY_WS_PORT=7382
# Prometheus metrics, always on 127.0.0.1.
REDIS_GATEWAY_METRICS_PORT=8405
# REDIS_GATEWAY_MAXCONN=4096
# Old workers keep pre-reload connections this long after make reload-redis-gateway.
# REDIS_GATEWAY_HARD_STOP_AFTER=1h

# Optional Prometheus redis_exporter per role, on REDIS_EXPORTER_BIND_ADDRESS.
REDIS_EXPORTER=off
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.97.0-alpine
REDIS_EXPORTER_BIND_ADDRESS=127.0.0.1
REDIS_CACHE_EXPORTER_PORT=9121
REDIS_SESSION_EXPORTER_PORT=9122
REDIS_QUEUE_EXPORTER_PORT=9123
REDIS_WS_EXPORTER_PORT=9124
# Generated when REDIS_EXPORTER=on.
REDIS_EXPORTER_PASSWORD=

# Backups (make backup redis). Must be outside the checkout.
REDIS_BACKUP_DIR=/srv/prod-services/backups/redis
REDIS_BACKUP_RETENTION_DAYS=14
REDIS_BACKUP_KEEP_MIN=3
# Defaults to every enabled role with persistence.
# REDIS_BACKUP_ROLES=session,queue
