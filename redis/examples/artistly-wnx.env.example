# prod-services Redis for Artistly on wnx (108.171.206.234, public NIC enp39s0).
# Copy over redis/.env.example values:  cp redis/examples/artistly-wnx.env.example redis/.env
# Then: make ensure-redis-env (generates passwords), edit redis/gateway.allowlist, make serve redis.
# Runbook: redis/docs/artistly-onboarding.md

REDIS_IMAGE=redis:8.8.4-alpine

# Standard roles only. Old db0 -> queue, old db1 -> cache, old redis_session -> session.
# Each role has databases 1; there is no 16-database legacy mode.
REDIS_ROLES=cache,session,queue

REDIS_COMPOSE_PROJECT_NAME=redis
# App containers on wnx (if any) join this network with `external: true`
# and connect to redis-queue:6379, redis-cache:6379, redis-session:6379.
REDIS_NETWORK_NAME=artistly-redis

# Loopback only. Remote clients (editor, ffmpeg VMs) come through the gateway.
REDIS_BIND_ADDRESS=127.0.0.1

REDIS_CACHE_CONTAINER_NAME=redis-cache
REDIS_SESSION_CONTAINER_NAME=redis-session
REDIS_QUEUE_CONTAINER_NAME=redis-queue

# Not 6379/6380: the legacy containers hold those until decommission.
REDIS_CACHE_HOST_PORT=6390
REDIS_SESSION_HOST_PORT=6391
REDIS_QUEUE_HOST_PORT=6392

#   sudo install -d -m 0700 -o 999 -g 999 /srv/prod-services/redis/{cache,session,queue}
REDIS_CACHE_DATA_DIR=/srv/prod-services/redis/cache
REDIS_SESSION_DATA_DIR=/srv/prod-services/redis/session
REDIS_QUEUE_DATA_DIR=/srv/prod-services/redis/queue

# queue: Laravel queues, Horizon, cache locks (lock_connection=default) and the
# AccumulatorService counters, which have no TTL. Must never be evicted or lost.
REDIS_QUEUE_PERSISTENCE=aof
REDIS_QUEUE_MAXMEMORY_POLICY=noeviction
# cache: the old db1. Evictable.
REDIS_CACHE_PERSISTENCE=none
REDIS_CACHE_MAXMEMORY_POLICY=allkeys-lru
# sessions survive restarts.
REDIS_SESSION_PERSISTENCE=rdb
REDIS_SESSION_MAXMEMORY_POLICY=volatile-ttl

# Legacy redis_app used about 1.75 GB for db0+db1 together. noeviction means a
# full queue instance rejects writes, so give it at least 2x what db0 uses
# today. Measure before cutover (the migration dry run prints used memory), then
# set explicit values; leave the host budget split as a fallback.
REDIS_QUEUE_MAXMEMORY_MB=4096
REDIS_CACHE_MAXMEMORY_MB=1024
REDIS_SESSION_MAXMEMORY_MB=512

REDIS_PIDS_LIMIT=4096
REDIS_STOP_GRACE_PERIOD=30s
REDIS_LOG_MAX_SIZE=100m
REDIS_LOG_MAX_FILE=5

# Generated by make ensure-redis-env. Never reuse the legacy passwords: they
# were exposed to ~106k attempts from the internet.
REDIS_CACHE_PASSWORD=
REDIS_SESSION_PASSWORD=
REDIS_QUEUE_PASSWORD=
REDIS_ADMIN_PASSWORD=

# Allowlisted TCP gateway for the editor server and the ffmpeg worker VMs.
# redis/gateway.allowlist:
#   108.171.203.171   # editor server
#   50.115.45.242     # ffmpeg worker VMs (NAT)
REDIS_GATEWAY=on
REDIS_GATEWAY_IMAGE=haproxy:3.2.26-alpine
REDIS_GATEWAY_CONTAINER_NAME=redis-gateway
REDIS_GATEWAY_BIND_ADDRESS=108.171.206.234
REDIS_GATEWAY_ALLOWLIST_FILE=./gateway.allowlist
REDIS_GATEWAY_CACHE_PORT=7379
REDIS_GATEWAY_SESSION_PORT=7380
REDIS_GATEWAY_QUEUE_PORT=7381
REDIS_GATEWAY_METRICS_PORT=8405

REDIS_EXPORTER=on
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.97.0-alpine
REDIS_EXPORTER_BIND_ADDRESS=127.0.0.1
REDIS_CACHE_EXPORTER_PORT=9121
REDIS_SESSION_EXPORTER_PORT=9122
REDIS_QUEUE_EXPORTER_PORT=9123
REDIS_EXPORTER_PASSWORD=

REDIS_BACKUP_DIR=/srv/prod-services/backups/redis
REDIS_BACKUP_RETENTION_DAYS=14
REDIS_BACKUP_KEEP_MIN=3
