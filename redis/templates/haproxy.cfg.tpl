# Generated by scripts/generate-redis-config.sh on {{GENERATED_AT}}
# TCP gateway for Redis clients on other hosts. Connections from addresses not
# in allowlist.lst are closed before a single byte reaches Redis.
#
# Check:  docker exec <gateway> haproxy -c -f /usr/local/etc/haproxy/haproxy.cfg
# Reload: docker kill -s USR2 <gateway>   (or: make reload-redis-gateway)

global
    log stdout format raw local0 info
    maxconn {{MAXCONN}}
    # After a reload, old workers keep serving existing connections for at most
    # this long (then they are closed and clients reconnect through the new
    # worker). Restart the gateway to cut a revoked client off immediately.
    hard-stop-after {{HARD_STOP_AFTER}}

defaults
    mode tcp
    log global
    log-format "%ci:%cp [%t] %ft %b/%s %Tw/%Tc/%Tt %B %ts %ac/%fc/%bc/%sc/%rc"
    timeout connect 5s
    # Queue workers hold idle blocking connections (BLPOP/BRPOP); keep them.
    timeout client 24h
    timeout server 24h
    timeout client-fin 30s
    timeout server-fin 30s
    option clitcpka
    option srvtcpka

resolvers docker
    nameserver dns 127.0.0.11:53
    resolve_retries 3
    timeout resolve 1s
    timeout retry 1s
    hold valid 10s
    hold obsolete 30s

# Prometheus metrics and denied-connection counters
# (haproxy_frontend_denied_connections_total). Published on loopback only.
frontend metrics
    mode http
    bind :8405
    option dontlog-normal
    http-request use-service prometheus-exporter if { path /metrics }
    http-request return status 200 content-type text/plain string "ok" if { path /healthz }
    http-request deny
{{FRONTENDS}}
