# Host resources detected: {{HOST_MEMORY_MB}}MB RAM, {{CPU_CORES}} CPU cores.
# Host/Docker reserve: {{HOST_MEMORY_RESERVE_PERCENT}}% ({{HOST_MEMORY_RESERVED_MB}}MB).
# Redis maxmemory budget: {{REDIS_MEMORY_BUDGET_PERCENT}}% of remaining RAM ({{REDIS_MEMORY_BUDGET_MB}}MB total).

port 6379
bind 0.0.0.0 -::*
protected-mode yes
dir /data
databases 1

# Users and SHA-256 password hashes. The file sits in a read-only mount, so
# ACL SAVE and CONFIG REWRITE fail by design: redis/.env is the source of truth.
aclfile /usr/local/etc/redis/users.acl
acllog-max-len 256

enable-debug-command no
enable-module-command no
enable-protected-configs no

maxmemory {{MAXMEMORY_MB}}mb
maxmemory-policy {{MAXMEMORY_POLICY}}
maxmemory-samples {{MAXMEMORY_SAMPLES}}

{{PERSISTENCE_BLOCK}}

{{LAZYFREE_BLOCK}}

dynamic-hz yes
hz 10
tcp-keepalive 60
timeout 0
maxclients 10000
slowlog-log-slower-than 10000
slowlog-max-len 256
latency-monitor-threshold 100
loglevel notice
